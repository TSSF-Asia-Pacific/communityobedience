{
    "name": "tssf/communityobedience",
    "description": "This web application is built to assist brothers and sisters of the Third Order of the Society of St. Francis (TSSF) with their Community Obedience Prayer",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Tssf\\Communityobedience\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tssf\\Communityobedience\\Tests\\": "tests/"
        }
    },
    "require": {
        "twig/twig": "^3.0",
        "symfony/translation": "^6.1",
        "symfony/twig-bridge": "^6.1",
        "symfony/config": "^6.1",
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "rector": "rector process",
        "test": "phpunit"
    }
}
